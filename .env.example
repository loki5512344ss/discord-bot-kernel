# Bot (Rust) - use BOT token (generate in Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here
BOT_PREFIX=!
BOT_ACTIVITY=!help
GUILD_ID=your_guild_id
SUPER_ADMIN_ID=your_discord_user_id
DB_PATH=data/bot.db
RUST_LOG=info,serenity=warn,sqlx=warn

# Backend integration (Phase 3 - blog)
BIO_API_URL=http://localhost:3001/api
DISCORD_BOT_SECRET=change-me-openssl-rand-hex-32

# Tickets - forum mode (Phase 3.2): one Forum channel with tags instead of category
# false = classic text channels in SUPPORT (max 500), true = forum posts (max 1000 active, tags)
TICKET_USE_FORUM=false
# Optional: force specific forum channel ID (if not set, auto-search by name "support-forum" or create)
# TICKET_FORUM_CHANNEL_ID=1234567890123456789

# JS inspector (tools/userbot/.env) - USER token only for local view (self-bot, ToS ban risk)
# DISCORD_USER_TOKEN=your_user_token_here
