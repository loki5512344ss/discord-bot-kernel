# Bot (Rust) - use BOT token (generate in Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here
BOT_PREFIX=!
BOT_ACTIVITY=!help
GUILD_ID=your_guild_id
SUPER_ADMIN_ID=your_discord_user_id
DB_PATH=data/bot.db
RUST_LOG=info,serenity=warn,sqlx=warn

# JS inspector (tools/userbot/.env) - USER token only for local view (self-bot, ToS ban risk)
# DISCORD_USER_TOKEN=your_user_token_here
